NODE_ENV="development"
DATABASE_URL="mysql://agrios:your_password@localhost:3306/agrios"
REDIS_URL="redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN="7d"
ENABLE_AUTO_EXECUTION=false
DEVICE_CONTROL_MODE=MOCK
DEVICE_CONTROL_DRY_RUN=true
VALVE_COMMAND_TIMEOUT_MS=10000
VALVE_MAX_OPEN_SECONDS=30
VALVE_REQUIRE_FEEDBACK=true
VALVE_ALLOW_REAL_CONTROL=false
THINGSBOARD_BASE_URL="http://localhost:8080"
THINGSBOARD_TOKEN=""
MQTT_USERNAME=""
MQTT_PASSWORD=""
EDGE_CONTROLLER_BASE_URL=""
EDGE_CONTROLLER_TOKEN=""
PLC_GATEWAY_BASE_URL=""
PLC_GATEWAY_TOKEN=""
PLC_TRANSPORT=FAKE
PLC_REAL_WRITE_ENABLED=false
PLC_MODBUS_HOST="127.0.0.1"
PLC_MODBUS_PORT=502
PLC_MODBUS_UNIT_ID=1
PLC_CONNECT_TIMEOUT_MS=2000
PLC_COMMAND_TIMEOUT_MS=2000
PLC_COMMAND_RETRY=0
ENABLE_BLUETOOTH_LOCAL=false
UPLOAD_MAX_FILE_MB=20
CORS_ORIGINS="http://localhost:5174,http://localhost:5173"
ACTION_QUEUE_DRIVER=bullmq
ACTION_QUEUE_MAX_RETRIES=3
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_CLIENT_ID="agrios-backend"
THINGSBOARD_WEBHOOK_SECRET="REPLACE_WITH_RANDOM_SECRET"
THINGSBOARD_URL="http://localhost:8080"
THINGSBOARD_BASE_URL="http://localhost:8080"
THINGSBOARD_USERNAME="tenant@thingsboard.org"
THINGSBOARD_PASSWORD="REPLACE_WITH_PASSWORD"
THINGSBOARD_MQTT_HOST="localhost"
THINGSBOARD_MQTT_PORT="18830"
THINGSBOARD_SYNC_ENABLED="false"
IOT_DEVICE_OFFLINE_MINUTES="10"
PORT=3000

