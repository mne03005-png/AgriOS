generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(cuid())
  tenantId          String?
  phone             String     @unique
  email             String?    @unique
  name              String
  passwordHash      String?
  tokenVersion      Int        @default(0)
  role              UserRole   @default(FARMER)
  status            UserStatus @default(ACTIVE)
  farmId            String?
  farm              Farm?      @relation(fields: [farmId], references: [id])
  remark            String?    @db.Text
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([farmId])
  @@index([tenantId])
  @@index([status])
  @@index([lockedUntil])
}

model Farm {
  id           String   @id @default(cuid())
  tenantId     String?
  name         String
  type         FarmType
  address      String?
  contactName  String?
  contactPhone String?
  remark       String?  @db.Text
  users        User[]
  fields       Field[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model Field {
  id                String             @id @default(cuid())
  tenantId          String?
  farmId            String
  farm              Farm               @relation(fields: [farmId], references: [id])
  name              String
  areaMu            Decimal            @db.Decimal(10, 2)
  location          String?
  latitude          Decimal?           @db.Decimal(10, 7)
  longitude         Decimal?           @db.Decimal(10, 7)
  soilType          String?
  waterSource       String?
  irrigationMethod  String?
  landSource        LandSource?
  lastYearCrop      String?
  currentSuggestion String?            @db.Text
  remark            String?            @db.Text
  cropSeasons       CropSeason[]
  devices           Device[]
  sensorRecords     SensorRecord[]
  irrigationRecords IrrigationRecord[]
  irrigationAdvices IrrigationAdvice[]
  workLogs          WorkLog[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([farmId])
  @@index([tenantId])
}

model CropSeason {
  id                String             @id @default(cuid())
  tenantId          String?
  fieldId           String
  field             Field              @relation(fields: [fieldId], references: [id])
  cropName          String
  variety           String?
  year              Int
  season            String?
  sowingDate        DateTime?
  expectedHarvestAt DateTime?
  actualHarvestAt   DateTime?
  managerName       String?
  status            CropSeasonStatus   @default(PLANNED)
  remark            String?            @db.Text
  farmInputs        FarmInput[]
  workLogs          WorkLog[]
  irrigationRecords IrrigationRecord[]
  irrigationAdvices IrrigationAdvice[]
  costRecords       CostRecord[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([fieldId, cropName, year, season])
  @@index([fieldId])
  @@index([tenantId])
}

model FarmInput {
  id              String        @id @default(cuid())
  tenantId        String?
  cropSeasonId    String
  cropSeason      CropSeason    @relation(fields: [cropSeasonId], references: [id])
  type            FarmInputType
  name            String
  brand           String?
  specification   String?
  purchaseChannel String?
  supplierName    String?
  quantity        Decimal       @db.Decimal(12, 2)
  unitPrice       Decimal?      @db.Decimal(12, 2)
  totalPrice      Decimal?      @db.Decimal(12, 2)
  purchaseDate    DateTime?
  usedDate        DateTime?
  remark          String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([cropSeasonId])
  @@index([tenantId])
}

model WorkLog {
  id            String      @id @default(cuid())
  tenantId      String?
  fieldId       String
  field         Field       @relation(fields: [fieldId], references: [id])
  cropSeasonId  String
  cropSeason    CropSeason  @relation(fields: [cropSeasonId], references: [id])
  type          WorkLogType
  workDate      DateTime
  workerName    String?
  farmInputRefs Json?
  areaMu        Decimal?    @db.Decimal(10, 2)
  laborHours    Decimal?    @db.Decimal(10, 2)
  cost          Decimal?    @db.Decimal(12, 2)
  imageUrls     Json?
  remark        String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([fieldId])
  @@index([cropSeasonId])
  @@index([tenantId])
}

model Device {
  id                     String              @id @default(cuid())
  tenantId               String?
  fieldId                String?
  field                  Field?              @relation(fields: [fieldId], references: [id])
  code                   String              @unique
  name                   String
  type                   DeviceType
  thingsboardDeviceId    String?             @unique
  thingsboardAccessToken String?
  iotStatus              IoTDeviceStatus     @default(ACTIVE)
  bindingSource          DeviceBindingSource @default(UNKNOWN)
  mqttTopic              String?
  online                 Boolean             @default(false)
  currentStatus          Json?
  lastReportedAt         DateTime?
  lastTelemetryAt        DateTime?
  remark                 String?             @db.Text
  sensorRecords          SensorRecord[]
  irrigationAdvices      IrrigationAdvice[]
  commands               DeviceCommand[]
  pumpRecords            IrrigationRecord[]  @relation("PumpDevice")
  valveRecords           IrrigationRecord[]  @relation("ValveDevice")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([fieldId])
  @@index([thingsboardDeviceId])
  @@index([tenantId])
}

model SensorRecord {
  id                  String                 @id @default(cuid())
  tenantId            String?
  farmId              String?
  deviceId            String?
  device              Device?                @relation(fields: [deviceId], references: [id])
  fieldId             String?
  field               Field?                 @relation(fields: [fieldId], references: [id])
  eventId             String?                @unique
  deviceName          String?
  thingsboardDeviceId String?
  type                SensorRecordType
  value               Decimal                @db.Decimal(12, 3)
  unit                String?
  soilMoisture        Decimal?               @db.Decimal(12, 3)
  temperature         Decimal?               @db.Decimal(12, 3)
  humidity            Decimal?               @db.Decimal(12, 3)
  battery             Decimal?               @db.Decimal(12, 3)
  rawPayload          Json?
  normalizedJson      Json?
  source              String                 @default("thingsboard")
  reportedAt          DateTime
  receivedAt          DateTime               @default(now())
  qualityStatus       TelemetryQualityStatus @default(UNKNOWN)
  qualityScore        Int?
  createdAt           DateTime               @default(now())

  @@index([deviceId, reportedAt])
  @@index([fieldId, reportedAt])
  @@index([tenantId])
  @@index([farmId])
  @@index([qualityStatus])
  @@index([receivedAt])
}

model IrrigationRecord {
  id            String                 @id @default(cuid())
  tenantId      String?
  fieldId       String
  field         Field                  @relation(fields: [fieldId], references: [id])
  cropSeasonId  String?
  cropSeason    CropSeason?            @relation(fields: [cropSeasonId], references: [id])
  startTime     DateTime
  endTime       DateTime?
  mode          IrrigationMode
  status        IrrigationRecordStatus @default(RUNNING)
  waterAmount   Decimal?               @db.Decimal(12, 2)
  pumpDeviceId  String?
  pumpDevice    Device?                @relation("PumpDevice", fields: [pumpDeviceId], references: [id])
  valveDeviceId String?
  valveDevice   Device?                @relation("ValveDevice", fields: [valveDeviceId], references: [id])
  triggerReason String?
  remark        String?                @db.Text
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([fieldId])
  @@index([cropSeasonId])
  @@index([tenantId])
}

model DeviceCommand {
  id           String              @id @default(cuid())
  tenantId     String?
  deviceId     String
  device       Device              @relation(fields: [deviceId], references: [id])
  command      String
  payload      Json?
  status       DeviceCommandStatus @default(PENDING)
  mqttTopic    String
  requestId    String              @unique
  sentAt       DateTime?
  ackAt        DateTime?
  errorMessage String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([deviceId, createdAt])
  @@index([status])
  @@index([tenantId])
}

model ServiceProvider {
  id               String              @id @default(cuid())
  tenantId         String?
  name             String
  type             ServiceProviderType
  contact          String?
  serviceArea      String?
  serviceContent   String?             @db.Text
  priceDescription String?             @db.Text
  recommended      Boolean             @default(false)
  remark           String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([tenantId])
}

model CostRecord {
  id             String     @id @default(cuid())
  tenantId       String?
  cropSeasonId   String
  cropSeason     CropSeason @relation(fields: [cropSeasonId], references: [id])
  type           CostType
  amount         Decimal    @db.Decimal(12, 2)
  occurredDate   DateTime
  sourceType     String?
  sourceId       String?
  sourceRecordId String?
  isReversed     Boolean    @default(false)
  reversedAt     DateTime?
  reverseReason  String?    @db.Text
  remark         String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([cropSeasonId])
  @@index([tenantId])
}

model IrrigationAdvice {
  id           String                 @id @default(cuid())
  tenantId     String?
  fieldId      String
  field        Field                  @relation(fields: [fieldId], references: [id])
  deviceId     String?
  device       Device?                @relation(fields: [deviceId], references: [id])
  cropSeasonId String?
  cropSeason   CropSeason?            @relation(fields: [cropSeasonId], references: [id])
  soilMoisture Decimal                @db.Decimal(12, 3)
  action       IrrigationAdviceAction
  message      String
  source       IrrigationAdviceSource @default(SYSTEM)
  status       IrrigationAdviceStatus @default(PENDING)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([fieldId, createdAt])
  @@index([deviceId])
  @@index([cropSeasonId])
  @@index([tenantId])
}

model OperationLog {
  id          String   @id @default(cuid())
  tenantId    String?
  userId      String?
  action      String
  targetType  String
  targetId    String
  description String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([tenantId])
}

model IoTWebhookDeadLetter {
  id                  String                  @id @default(cuid())
  tenantId            String?
  source              String                  @default("thingsboard")
  originalSource      String?
  eventId             String?
  eventType           String
  deviceName          String?
  thingsboardDeviceId String?
  rawPayload          Json?
  errorMessage        String                  @db.Text
  errorStack          String?                 @db.Text
  retryCount          Int                     @default(0)
  status              WebhookDeadLetterStatus @default(PENDING)
  retriedAt           DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([source, eventType])
  @@index([status, createdAt])
  @@index([thingsboardDeviceId])
  @@index([eventId])
  @@index([tenantId])
}

model IoTSyncAudit {
  id         String   @id @default(cuid())
  tenantId   String?
  source     String   @default("thingsboard")
  syncType   String
  total      Int      @default(0)
  created    Int      @default(0)
  updated    Int      @default(0)
  bound      Int      @default(0)
  unbound    Int      @default(0)
  warnings   Json?
  rawResult  Json?
  startedAt  DateTime
  finishedAt DateTime
  createdAt  DateTime @default(now())

  @@index([source, syncType])
  @@index([createdAt])
  @@index([tenantId])
}

model FieldStateSnapshot {
  id                   String         @id @default(cuid())
  tenantId             String?
  fieldId              String
  cropSeasonId         String?
  latestSensorRecordId String?
  soilMoisture         Decimal?       @db.Decimal(12, 3)
  temperature          Decimal?       @db.Decimal(12, 3)
  humidity             Decimal?       @db.Decimal(12, 3)
  deviceOnlineCount    Int            @default(0)
  deviceOfflineCount   Int            @default(0)
  riskLevel            FieldRiskLevel @default(NORMAL)
  summary              Json?
  createdAt            DateTime       @default(now())

  @@index([fieldId, createdAt])
  @@index([cropSeasonId])
  @@index([tenantId])
}

model DecisionRecord {
  id              String                 @id @default(cuid())
  tenantId        String?
  fieldId         String
  cropSeasonId    String?
  stateSnapshotId String?
  decisionType    DecisionType
  recommendation  DecisionRecommendation
  confidence      Decimal?               @db.Decimal(5, 2)
  reason          String                 @db.Text
  status          DecisionStatus         @default(PROPOSED)
  metadata        Json?
  actionPlans     ActionPlan[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([fieldId, createdAt])
  @@index([cropSeasonId])
  @@index([stateSnapshotId])
  @@index([tenantId])
}

model ActionPlan {
  id         String            @id @default(cuid())
  tenantId   String?
  decisionId String
  decision   DecisionRecord    @relation(fields: [decisionId], references: [id])
  fieldId    String
  status     ActionPlanStatus  @default(PLANNED)
  actions    Json
  safety     Json?
  executions ActionExecution[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([decisionId])
  @@index([fieldId, createdAt])
  @@index([status])
  @@index([tenantId])
}

model ActionExecution {
  id           String                @id @default(cuid())
  tenantId     String?
  actionPlanId String
  actionPlan   ActionPlan            @relation(fields: [actionPlanId], references: [id])
  deviceId     String?
  command      String
  status       ActionExecutionStatus @default(PENDING)
  requestId    String?
  result       Json?
  executedAt   DateTime?
  feedbackAt   DateTime?
  feedback     Json?
  errorMessage String?               @db.Text
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([actionPlanId])
  @@index([deviceId])
  @@index([status])
  @@index([tenantId])
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  type      TenantType   @default(FARM_GROUP)
  status    TenantStatus @default(ACTIVE)
  metadata  Json?
  remark    String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model TenantFarm {
  id        String   @id @default(cuid())
  tenantId  String
  farmId    String
  role      String?
  createdAt DateTime @default(now())

  @@unique([tenantId, farmId])
  @@index([tenantId])
  @@index([farmId])
}

model SubscriptionPlan {
  id                 String   @id @default(cuid())
  tenantId           String?
  name               String
  monthlyPrice       Decimal  @default(0) @db.Decimal(12, 2)
  pricePerHectare    Decimal  @default(0) @db.Decimal(12, 4)
  pricePerDevice     Decimal  @default(0) @db.Decimal(12, 4)
  pricePerAiDecision Decimal  @default(0) @db.Decimal(12, 4)
  features           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
}

model BillingAccount {
  id        String        @id @default(cuid())
  tenantId  String
  farmId    String?
  planId    String?
  status    BillingStatus @default(ACTIVE)
  balance   Decimal       @default(0) @db.Decimal(12, 2)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([tenantId])
  @@index([farmId])
}

model UsageRecord {
  id         String    @id @default(cuid())
  tenantId   String
  farmId     String?
  fieldId    String?
  deviceId   String?
  usageType  UsageType
  quantity   Decimal   @default(1) @db.Decimal(12, 3)
  unit       String?
  costAmount Decimal   @default(0) @db.Decimal(12, 2)
  metadata   Json?
  occurredAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([tenantId, occurredAt])
  @@index([farmId])
  @@index([usageType])
}

model Invoice {
  id          String        @id @default(cuid())
  tenantId    String
  accountId   String?
  amount      Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(DRAFT)
  periodStart DateTime?
  periodEnd   DateTime?
  lineItems   Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId])
  @@index([accountId])
}

model CostCenter {
  id        String   @id @default(cuid())
  tenantId  String
  farmId    String?
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([farmId])
}

model OperationCost {
  id        String                @id @default(cuid())
  tenantId  String?
  farmId    String
  fieldId   String?
  refType   String
  refId     String
  category  OperationCostCategory
  amount    Float                 @default(0)
  currency  String                @default("CNY")
  quantity  Float?
  unit      String?
  unitPrice Float?
  note      String?               @db.Text
  createdAt DateTime              @default(now())

  @@index([tenantId])
  @@index([farmId])
  @@index([fieldId])
  @@index([refType, refId])
  @@index([category])
}

model ApprovalRequest {
  id               String         @id @default(cuid())
  tenantId         String?
  farmId           String?
  fieldId          String?
  actionPlanId     String?
  decisionRecordId String?
  type             ApprovalType   @default(ACTION_PLAN)
  targetType       String
  targetId         String
  riskLevel        String?
  status           ApprovalStatus @default(PENDING)
  requestedBy      String?
  approvedBy       String?
  reason           String?        @db.Text
  payload          Json?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  decidedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([tenantId])
  @@index([farmId])
  @@index([fieldId])
  @@index([actionPlanId])
  @@index([decisionRecordId])
  @@index([targetType, targetId])
  @@index([status])
}

model SafetyAlert {
  id         String        @id @default(cuid())
  tenantId   String?
  farmId     String?
  fieldId    String?
  severity   AlertSeverity
  alertType  String
  message    String        @db.Text
  status     AlertStatus   @default(OPEN)
  metadata   Json?
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?

  @@index([tenantId])
  @@index([farmId])
  @@index([fieldId])
  @@index([status])
}

model DigitalTwinSnapshot {
  id                 String   @id @default(cuid())
  tenantId           String?
  fieldId            String
  simulatedSoilState Json?
  predictedWaterUse  Decimal? @db.Decimal(12, 3)
  yieldEstimate      Decimal? @db.Decimal(12, 3)
  createdAt          DateTime @default(now())

  @@index([tenantId])
  @@index([fieldId, createdAt])
}

model FieldBoundary {
  id               String           @id @default(cuid())
  tenantId         String?
  farmId           String
  fieldId          String?
  name             String
  source           BoundarySource
  coordinateSystem CoordinateSystem @default(WGS84)
  polygon          Json
  area             Float?
  areaSquareMeters Float?
  areaMu           Float?
  confidence       Float?
  status           BoundaryStatus   @default(CANDIDATE)
  rawInput         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId])
  @@index([farmId])
  @@index([fieldId])
  @@index([status])
}

model GpsTrack {
  id               String           @id @default(cuid())
  tenantId         String?
  farmId           String
  name             String
  source           String
  coordinateSystem CoordinateSystem @default(WGS84)
  trackJson        Json
  rawFileName      String?
  metadata         Json?
  createdAt        DateTime         @default(now())

  @@index([tenantId])
  @@index([farmId])
}

model DroneMapJob {
  id             String            @id @default(cuid())
  tenantId       String?
  farmId         String
  name           String
  status         DroneMapJobStatus @default(UPLOADED)
  imageCount     Int?
  flightTrack    Json?
  orthomosaicUrl String?
  resultJson     Json?
  errorMessage   String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([tenantId])
  @@index([farmId])
  @@index([status])
}

model MapLayer {
  id               String           @id @default(cuid())
  tenantId         String?
  farmId           String
  name             String
  type             MapLayerType
  source           String
  coordinateSystem CoordinateSystem @default(WGS84)
  geoJson          Json
  styleJson        Json?
  isVisible        Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId])
  @@index([farmId])
  @@index([type])
}

model DroneOperation {
  id               String               @id @default(cuid())
  tenantId         String?
  farmId           String
  fieldId          String?
  fieldBoundaryId  String?
  droneBrand       String               @default("DJI")
  droneModel       String?
  operationType    DroneOperationType
  source           DroneOperationSource
  sourceFileName   String?
  coordinateSystem CoordinateSystem?
  plannedAreaMu    Float?
  actualAreaMu     Float?
  coverageRate     Float?
  overlapRate      Float?
  missedAreaMu     Float?
  repeatedAreaMu   Float?
  flightDistanceM  Float?
  flightDurationS  Int?
  sprayVolumeL     Float?
  chemicalName     String?
  dosagePerMu      Float?
  routeGeoJson     Json?
  coverageGeoJson  Json?
  prescriptionJson Json?
  rawJson          Json?
  status           DroneOperationStatus @default(IMPORTED)
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([tenantId])
  @@index([farmId])
  @@index([fieldId])
  @@index([fieldBoundaryId])
  @@index([operationType])
  @@index([source])
  @@index([status])
}

model DroneImportJob {
  id           String               @id @default(cuid())
  tenantId     String?
  farmId       String
  fieldId      String?
  source       DroneOperationSource
  fileName     String
  fileType     DroneOperationSource
  status       DroneImportJobStatus @default(UPLOADED)
  parsedJson   Json?
  errorMessage String?              @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([tenantId])
  @@index([farmId])
  @@index([fieldId])
  @@index([source])
  @@index([fileType])
  @@index([status])
}

model DroneOperationReview {
  id                       String                     @id @default(cuid())
  tenantId                 String?
  farmId                   String
  droneOperationId         String
  status                   DroneOperationReviewStatus @default(PENDING)
  reviewerId               String?
  reviewNote               String?                    @db.Text
  correctedFieldId         String?
  correctedFieldBoundaryId String?
  correctedCoverageGeoJson Json?
  correctedRouteGeoJson    Json?
  confirmedAreaMu          Float?
  confirmedCoverageRate    Float?
  confirmedMissedAreaMu    Float?
  confirmedRepeatedAreaMu  Float?
  createdAt                DateTime                   @default(now())
  reviewedAt               DateTime?
  updatedAt                DateTime                   @updatedAt

  @@index([tenantId])
  @@index([farmId])
  @@index([droneOperationId])
  @@index([status])
}

model AIRecognitionJob {
  id           String              @id @default(cuid())
  tenantId     String?
  farmId       String
  type         AIRecognitionType
  inputSource  String
  inputJson    Json
  status       AIRecognitionStatus @default(PENDING)
  resultJson   Json?
  confidence   Float?
  errorMessage String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([tenantId])
  @@index([farmId])
  @@index([type])
  @@index([status])
}

model IrrigationDesign {
  id                  String                 @id @default(cuid())
  tenantId            String?
  farmId              String
  fieldId             String
  fieldBoundaryId     String?
  name                String
  cropType            String
  soilType            String
  designMode          IrrigationDesignMode
  area                Decimal?               @db.Decimal(12, 2)
  areaMu              Float?
  rowSpacing          Decimal?               @db.Decimal(10, 3)
  plantSpacing        Decimal?               @db.Decimal(10, 3)
  lateralSpacing      Decimal?               @db.Decimal(10, 3)
