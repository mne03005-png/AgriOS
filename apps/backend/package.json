{
  "name": "@agrios/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "sim:p13:mqtt": "ts-node scripts/simulators/mqtt-device-simulator.ts",
    "sim:p13:thingsboard": "ts-node scripts/simulators/thingsboard-telemetry-simulator.ts",
    "sim:p13:edge": "ts-node scripts/simulators/edge-controller-simulator.ts",
    "sim:p13:valve": "ts-node scripts/simulators/valve-controller-simulator.ts",
    "sim:p13:valve:failure": "node -e \"process.env.SCENARIO='failure'; require('ts-node/register'); require('./scripts/simulators/valve-controller-simulator.ts')\"",
    "sim:p13:valve:timeout": "node -e \"process.env.SCENARIO='timeout'; require('ts-node/register'); require('./scripts/simulators/valve-controller-simulator.ts')\"",
    "test:stage2": "node scripts/verify-stage2-auth.mjs",
    "test:stage3": "node scripts/verify-stage3-ops.mjs",
    "test:stage4": "node scripts/verify-stage4-readonly-iot.mjs",
    "test:phase-a": "node scripts/verify-phase-a-security.mjs",
    "test:p0-plc": "ts-node scripts/verify-p0-plc-control-path.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/client": "^6.10.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mqtt": "^5.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "prisma": "^6.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.66.0"
  }
}
