# Copy to /home/ubuntu/agrios-server/.env.production, chmod 600, then replace every CHANGE_ME value.
COMPOSE_PROJECT_NAME=agrios-production
AGRIOS_IMAGE_TAG=production
AGRIOS_API_HOST_PORT=3200
AGRIOS_WEB_HOST_PORT=3201

MYSQL_DATABASE=agrios
MYSQL_USER=agrios
MYSQL_PASSWORD=CHANGE_ME_MYSQL_URL_SAFE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
DATABASE_URL=mysql://agrios:CHANGE_ME_MYSQL_URL_SAFE_PASSWORD@agrios-mysql:3306/agrios

REDIS_URL=redis://agrios-redis:6379

JWT_SECRET=CHANGE_ME_MINIMUM_48_RANDOM_CHARACTERS
JWT_EXPIRES_IN=15m
CORS=https://agrios.xyzwtt.com
VITE_API_BASE_URL=https://agrios-api.xyzwtt.com/api/v1

MQTT_URL=mqtts://agrios-mqtt.xyzwtt.com:8883
MQTT_CLIENT_ID=agrios-api-production
MQTT_USERNAME=agrios-api
MQTT_PASSWORD=CHANGE_ME_MQTT_RANDOM_PASSWORD
MQTT_TLS_BIND_ADDRESS=0.0.0.0
MQTT_TLS_PORT=8883
DEVICE_OFFLINE_AFTER_SECONDS=300

AGRIOS_SECRETS_DIR=/home/ubuntu/agrios-server/secrets
AGRIOS_TLS_DIR=/home/ubuntu/agrios-server/secrets/mosquitto/tls

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
SPEECH_SERVICE_URL=http://127.0.0.1:8000
